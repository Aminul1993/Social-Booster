# =============================================================================
# AI Marketing Post Builder - environment configuration
# Copy to .env and fill in the secrets.  NEVER commit .env.
# Full reference: docs/ENVIRONMENT.md
# =============================================================================

# ---------------------------------------------------------------- application
APP_NAME=AI Marketing Post Builder
# development | production | test   (production enforces secure settings)
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# json (log shippers) | console (humans)
LOG_FORMAT=console
HOST=127.0.0.1
PORT=8000
# Public origin of the app. Buffer downloads images from here, so in production
# it must be reachable from the internet (e.g. https://social.example.com).
PUBLIC_BASE_URL=
# Comma-separated Host headers to accept, or * (development only).
ALLOWED_HOSTS=*
# /docs and /redoc; defaults to on outside production.
ENABLE_API_DOCS=
# Hard cap for any request body; empty = one full upload batch + 1 MB.
MAX_REQUEST_BODY_MB=

# ------------------------------------------------------------------- security
# 32+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_NAME=mab_session
SESSION_MAX_AGE_SECONDS=1209600
# Secure cookie flag. Empty = on in production, off otherwise.
COOKIE_SECURE=
# Optional dedicated Fernet key for encrypting stored OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- persistence
DATABASE_PATH=data/app.db
UPLOAD_DIR=uploads
# Drafts (and their images) untouched for this long are deleted. 0 = keep forever.
DRAFT_RETENTION_HOURS=72
MAX_DRAFTS_PER_SESSION=100

# -------------------------------------------------------------------- uploads
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_UPLOAD=10
MAX_IMAGE_PIXELS=40000000
IMAGE_QUALITY=90

# ------------------------------------------------------- vision (ResNet-50)
# resnet50 | disabled (users type keywords themselves)
VISION_BACKEND=resnet50
VISION_WEIGHTS=IMAGENET1K_V2
VISION_TOP_K=5
VISION_MIN_CONFIDENCE=0.0
VISION_NUM_THREADS=2
VISION_MAX_CONCURRENCY=2
VISION_WARMUP=true
VISION_TIMEOUT_SECONDS=30

# --------------------------------------------------------------- Ollama Cloud
OLLAMA_API_KEY=
# OpenAI-compatible endpoint (default) or Ollama's native /api/chat.
OLLAMA_ENDPOINT=https://ollama.com/v1/chat/completions
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=512
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_RETRIES=3
CAPTION_MAX_CHARS=150
HASHTAGS_MIN=5
HASHTAGS_MAX=8

# --------------------------------------------------------------------- Buffer
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Must exactly match the redirect URI registered for your Buffer app.
BUFFER_REDIRECT_URI=http://localhost:8000/buffer/callback
BUFFER_OAUTH_URL=https://bufferapp.com/oauth2/authorize
BUFFER_TOKEN_URL=https://api.bufferapp.com/1/oauth2/token.json
BUFFER_PROFILES_URL=https://api.bufferapp.com/1/profiles.json
BUFFER_POST_URL=https://api.bufferapp.com/1/updates/create.json
BUFFER_SCOPE=
BUFFER_TIMEOUT_SECONDS=20
BUFFER_MAX_RETRIES=3
BUFFER_PROFILES_CACHE_SECONDS=300

# -------------------------------------------------------------- rate limiting
# <count>/<second|minute|hour|day> per client IP and per worker process.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_GENERATE=30/minute
RATE_LIMIT_SCHEDULE=20/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DEFAULT=120/minute

# -------------------------------------------------------------- observability
METRICS_ENABLED=true
# If set, /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=

# ------------------------------------------------- process manager (Docker)
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
FORWARDED_ALLOW_IPS=127.0.0.1
